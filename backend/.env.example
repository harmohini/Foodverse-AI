# FoodVerse AI - Backend Environment Configuration
# Copy this file to .env and fill in real values

# ─── AI Provider ─────────────────────────────────────────────
# Supported providers: gemini (primary), openai (optional fallback), demo
AI_PROVIDER=gemini

# Google Gemini API (Official Google Gen AI SDK — Primary Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI-compatible API (Optional fallback provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

# ─── App Settings ────────────────────────────────────────────
APP_NAME=FoodVerse AI
APP_ENV=development
DEBUG=true

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/foodverse.db

# ─── Upload Limits ───────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_DURATION_SECONDS=300

# ─── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Upload Storage ──────────────────────────────────────────
UPLOAD_DIR=./data/uploads
